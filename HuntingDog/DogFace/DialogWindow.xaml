<Window x:Class="HuntingDog.DogFace.DialogWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             Title="Hunting Dog Configuration"
             Height="700"
             Width="400"
             ResizeMode="NoResize"
             d:DesignHeight="300" d:DesignWidth="300">

    <Window.Resources>
        <!-- Brushes thématiques — mis à jour par ApplyTheme() -->
        <SolidColorBrush x:Key="DlgWindowBg"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DlgControlBg"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="DlgForeground"  Color="#000000"/>
        <SolidColorBrush x:Key="DlgBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="DlgButtonBg"    Color="#DDDDDD"/>
        <SolidColorBrush x:Key="DlgSelect"      Color="#200078D7"/>

        <!-- Styles implicites : les éditeurs du PropertyGrid les héritent -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="{DynamicResource DlgControlBg}"/>
            <Setter Property="Foreground"   Value="{DynamicResource DlgForeground}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource DlgBorderBrush}"/>
            <Setter Property="CaretBrush"   Value="{DynamicResource DlgForeground}"/>
        </Style>

        <!--
            ControlTemplate complet pour ComboBox.
            Le fond du Popup (DropDownBorder) est lié par DynamicResource :
            il se met automatiquement à jour quand ApplyTheme() change DlgControlBg.
        -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource DlgControlBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource DlgForeground}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource DlgBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <!-- Fond et bordure de la zone principale -->
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- Valeur sélectionnée -->
                            <ContentPresenter
                                    Margin="6,2,24,2"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <!-- Bouton toggle transparent avec flèche -->
                            <ToggleButton
                                    Focusable="False"
                                    ClickMode="Press"
                                    IsChecked="{Binding IsDropDownOpen,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Margin="0,0,6,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource DlgForeground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Popup du dropdown : DropDownBorder utilise DynamicResource -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource DlgControlBg}"
                                        BorderBrush="{DynamicResource DlgBorderBrush}"
                                        BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0">
                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem avec template dark-aware (hover + sélection) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource DlgControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource DlgForeground}"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource DlgSelect}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource DlgSelect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            CheckBox avec template personnalisé :
            le BulletChrome WPF par défaut rend le check non-stylable en mode sombre.
            Ce template utilise un Path vectoriel dont la couleur suit DlgForeground,
            visible quel que soit le thème.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"       Value="{DynamicResource DlgForeground}"/>
            <Setter Property="Background"       Value="{DynamicResource DlgControlBg}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource DlgBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                            <BulletDecorator.Bullet>
                                <Border x:Name="CheckBorder"
                                        Width="14" Height="14"
                                        CornerRadius="2"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Background="{TemplateBinding Background}">
                                    <Grid>
                                        <!-- Coche cochée : DynamicResource direct pour être
                                             indépendant de la valeur que Xceed force sur Foreground -->
                                        <Path x:Name="CheckMark"
                                              Visibility="Collapsed"
                                              Margin="2"
                                              Stretch="Uniform"
                                              StrokeThickness="0"
                                              Fill="{DynamicResource DlgForeground}"
                                              Data="M 1 5 L 4.5 8.5 L 11 1"/>
                                        <!-- État indéterminé -->
                                        <Rectangle x:Name="IndeterminateMark"
                                                   Visibility="Collapsed"
                                                   Margin="3"
                                                   Fill="{DynamicResource DlgForeground}"/>
                                    </Grid>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark"    Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder"  Property="BorderBrush"
                                        Value="{DynamicResource DlgForeground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush"
                                        Value="{DynamicResource DlgForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="{DynamicResource DlgBorderBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush"
                                        Value="{DynamicResource DlgBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource DlgForeground}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource DlgButtonBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource DlgForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DlgBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="rootGrid"
          Background="{DynamicResource DlgWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <xctk:PropertyGrid Grid.Row="0"
                           x:Name="_propertyGrid"
                           Background="{DynamicResource DlgWindowBg}"
                           Foreground="{DynamicResource DlgForeground}"
                           HorizontalAlignment="Stretch"
                           ShowSortOptions="False"
                           ShowSearchBox="False"
                           ShowSummary="True"
                           Padding="5"
                           NameColumnWidth="250"
                           PropertyValueChanged="OnPropertyValueChanged"/>

        <DockPanel Grid.Row="1"
                   Background="{DynamicResource DlgWindowBg}">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Height="40">
                <Button x:Name="btnOk"
                        Width="60"
                        Margin="5"
                        Click="Button_Click"
                        IsDefault="True">OK</Button>
                <Button x:Name="btnCancel"
                        Width="60"
                        Margin="5"
                        IsCancel="True"
                        Click="Button_Click_1">Cancel</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
