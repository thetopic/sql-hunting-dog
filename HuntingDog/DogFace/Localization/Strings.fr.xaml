<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Infobulles -->
    <sys:String x:Key="Str_TooltipServer">Serveur à explorer</sys:String>
    <sys:String x:Key="Str_TooltipDatabase">Base de données à flairer</sys:String>
    <sys:String x:Key="Str_TooltipRefresh">Recharger les bases et objets</sys:String>
    <sys:String x:Key="Str_TooltipLocate">Localiser dans l'explorateur</sys:String>

    <!-- Panneau résultats vides -->
    <sys:String x:Key="Str_NoResults">Aucun résultat trouvé</sys:String>
    <sys:String x:Key="Str_TryRefreshPart1">Essayez de </sys:String>
    <sys:String x:Key="Str_TryRefreshLink">Rafraîchir</sys:String>
    <sys:String x:Key="Str_TryRefreshPart2"> la base</sys:String>

    <!-- Pied de page -->
    <sys:String x:Key="Str_Options">Paramètres</sys:String>
    <sys:String x:Key="Str_StatusLanguageChanged">Langue : Français</sys:String>

    <!-- Messages de la barre de statut -->
    <sys:String x:Key="Str_StatusError">Erreur : {0}</sys:String>
    <sys:String x:Key="Str_StatusReloading">Rechargement de {0}...</sys:String>
    <sys:String x:Key="Str_StatusReloadDone">{0} rechargé</sys:String>
    <sys:String x:Key="Str_StatusSearching">Recherche de '{0}' dans {1}</sys:String>
    <sys:String x:Key="Str_StatusFoundN">{0} objets trouvés</sys:String>
    <sys:String x:Key="Str_StatusFoundNothing">Rien trouvé. Essayez de rafraîchir</sys:String>
    <sys:String x:Key="Str_StatusFoundOne">Un seul objet trouvé</sys:String>

    <!-- Catégories de configuration -->
    <sys:String x:Key="Cat_SELECT">SÉLECTION</sys:String>
    <sys:String x:Key="Cat_SCRIPT">SCRIPT</sys:String>
    <sys:String x:Key="Cat_GENERAL">GÉNÉRAL</sys:String>
    <sys:String x:Key="Cat_MODIFY">MODIFICATION</sys:String>

    <!-- Noms des propriétés de configuration -->
    <sys:String x:Key="Prop_IncludeAllColumns">Colonnes dans le SELECT</sys:String>
    <sys:String x:Key="Prop_ScriptIndexes">Scripter les index</sys:String>
    <sys:String x:Key="Prop_ScriptTriggers">Scripter les triggers</sys:String>
    <sys:String x:Key="Prop_ScriptForeignKeys">Scripter les clés étrangères</sys:String>
    <sys:String x:Key="Prop_AddWhereClauseFor">Ajouter une clause WHERE</sys:String>
    <sys:String x:Key="Prop_AddNoLock">Ajouter WITH(NOLOCK)</sys:String>
    <sys:String x:Key="Prop_OrderBy">Ordre du résultat</sys:String>
    <sys:String x:Key="Prop_SelectTopX">Sélectionner les X premiers</sys:String>
    <sys:String x:Key="Prop_LimitSearch">Limite de recherche</sys:String>
    <sys:String x:Key="Prop_FontSize">Taille de police</sys:String>
    <sys:String x:Key="Prop_LaunchingHotKey">Raccourci : Ctrl+</sys:String>
    <sys:String x:Key="Prop_HideAfterAction">Masquer après action</sys:String>
    <sys:String x:Key="Prop_ShowAfterOpen">Afficher à l'ouverture</sys:String>
    <sys:String x:Key="Prop_AlterOrCreate">Inspecter le corps avec</sys:String>
    <sys:String x:Key="Prop_Language">Langue</sys:String>

    <!-- Descriptions des propriétés de configuration -->
    <sys:String x:Key="Desc_IncludeAllColumns">Utiliser 'SELECT *' ou 'SELECT col1, col2..' dans la requête</sys:String>
    <sys:String x:Key="Desc_ScriptIndexes">Inclure les index lors du script d'une table</sys:String>
    <sys:String x:Key="Desc_ScriptTriggers">Inclure les triggers lors du script d'une table</sys:String>
    <sys:String x:Key="Desc_ScriptForeignKeys">Inclure les clés étrangères lors du script d'une table</sys:String>
    <sys:String x:Key="Desc_AddWhereClauseFor">Ajoute une clause WHERE commentée avec toutes les colonnes et leurs types</sys:String>
    <sys:String x:Key="Desc_AddNoLock">Ajoute le hint NOLOCK. Peut retourner des données inconsistantes</sys:String>
    <sys:String x:Key="Desc_OrderBy">Ajouter un ORDER BY sur la clé primaire en fin de SELECT</sys:String>
    <sys:String x:Key="Desc_SelectTopX">Nombre maximum de lignes retournées lors d'un SELECT</sys:String>
    <sys:String x:Key="Desc_LimitSearch">Récupérer uniquement les X premiers objets trouvés</sys:String>
    <sys:String x:Key="Desc_FontSize">Nécessite un redémarrage SSMS. Taille de police des résultats.</sys:String>
    <sys:String x:Key="Desc_LaunchingHotKey">Nécessite un redémarrage SSMS. Lancer Hunting Dog avec Ctrl + cette touche.</sys:String>
    <sys:String x:Key="Desc_HideAfterAction">Masquer la fenêtre Hunting Dog après chaque action.</sys:String>
    <sys:String x:Key="Desc_ShowAfterOpen">Afficher Hunting Dog à la création du panneau.</sys:String>
    <sys:String x:Key="Desc_AlterOrCreate">Utiliser ALTER ou CREATE pour inspecter procédures, vues et fonctions.</sys:String>
    <sys:String x:Key="Desc_Language">Langue de l'interface. Prend effet immédiatement.</sys:String>

</ResourceDictionary>
